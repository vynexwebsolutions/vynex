# VYNEX/.env.example — copy this file to ".env" and fill in your values.
# Find both in Supabase → Project Settings → API.

# Project URL, e.g. https://abcdxyz.supabase.co
SUPABASE_URL=

# The "anon public" key (safe for the browser — protected by Row Level Security)
SUPABASE_ANON_KEY=

# NEVER put the "service_role" key in this file or anywhere in the website.
# (It is only used inside Supabase Edge Functions, where Supabase provides it automatically.)

host=aws-0-eu-west-1.pooler.supabase.com
port=5432
database=postgres
user=postgres.dvbmmvuzafzsqzautdid
# Your website address, no trailing slash (e.g. https://vynex.co.ke). Used to create sitemap.xml, robots.txt,
# canonical links and search-engine business data. Leave empty until you know the final address.
SITE_URL=
